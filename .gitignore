# ============================================================
# Mini Semantic Search — .gitignore
# ============================================================

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Pytest cache
.pytest_cache/
.cache/

# ChromaDB persistence directory (can be regenerated by running the notebook)
chroma_db/

# HuggingFace / Sentence Transformers model cache
# (models are downloaded automatically on first run)
.cache/huggingface/
models/
*.bin
*.safetensors
*.onnx

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Secrets and environment files — NEVER commit these
.env
.env.*
secrets.json
*.pem
*.key

# Coverage reports
.coverage
htmlcov/
coverage.xml

# Temporary files
*.tmp
*.log
*.bak
